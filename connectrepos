# ----- connectors------
CONNECTOR_ENDPOINTS = {
    "code": "/connector/code/connectors",
    "knowledge": "/connector/knowledge/connectors",
    "planning": "/connector/planning/connectors",
    "itsm": "/connector/itsm/get_itsm_connectors",
}


def _get_connector_endpoint(connector_type: str) -> str:
    connector_type = connector_type.strip().lower()

    if connector_type not in CONNECTOR_ENDPOINTS:
        raise ValueError(
            f"Unsupported connector_type '{connector_type}'. "
            f"Supported values: {', '.join(CONNECTOR_ENDPOINTS.keys())}"
        )

    return CONNECTOR_ENDPOINTS[connector_type]


@secure_tool()
def list_connectors(
    project_name: str,
    workspace_name: str,
    connector_type: str,
) -> dict[str, Any]:
    """
    List connectors for a workspace.

    Supported connector types:
    - code
    - knowledge
    - planning
    - itsm
    """

    workspace = _validate_workspace(
        project_name,
        workspace_name,
    )

    if not workspace.get("access"):
        return workspace

    workspace_id = workspace.get("workspace_id")

    if workspace_id is None:
        return {
            "access": False,
            "message": (
                f"Workspace ID was not found for "
                f"'{workspace_name}'."
            ),
        }

    try:
        endpoint = _get_connector_endpoint(
            connector_type
        )
    except ValueError as exc:
        return {
            "access": False,
            "message": str(exc),
        }

    try:
        response = _api_get(
            endpoint,
            {
                "workspace_id": workspace_id,
            },
            timeout=60,
        )

    except requests.HTTPError as exc:

        status_code = (
            exc.response.status_code
            if exc.response is not None
            else None
        )

        return {
            "access": False,
            "message": (
                f"Connector lookup failed with "
                f"HTTP {status_code}."
            ),
        }

    connectors = []

    if isinstance(response, dict):
        connectors = response.get("connectors", [])

    return {
        "access": True,
        "project_name": project_name,
        "workspace_name": workspace_name,
        "workspace_id": workspace_id,
        "connector_type": connector_type.lower(),
        "connector_count": len(connectors),
        "connectors": connectors,
    }
@secure_tool()
def add_knowledge_connector(
    project_name: str,
    workspace_name: str,
    connector_name: str,
    connection_name: str,
    connector_config: dict[str, Any],
) -> dict[str, Any]:
    """
    Add a knowledge connector.
    """
    workspace = _validate_workspace(
        project_name,
        workspace_name,
    )
    if not workspace.get("access"):
        return workspace
    validate_payload = {
        "connector_name": connector_name,
        "connection_name": connection_name,
        **connector_config,
    }
    validation = _api_post(
        "/connector/knowledge/validate",
        validate_payload,
    )

    if not validation.get("success"):
        return validation
    save_payload = {
    "connector_type": "knowledge",
    "connector_name": connector_name,
    "connection_name": connection_name,
    "workspace_id": workspace["workspace_id"],

    "automation_type": "Manual",
    "created_by": "Admin",
    "ingestion_automation": "False",

    **connector_config,
}
    save_result = _api_post(
        "/connector/knowledge/save",
        save_payload,
    )

    return save_result
@secure_tool()
def update_knowledge_connector(
    project_name: str,
    workspace_name: str,
    connector_id: int,
    connector_name: str,
    connection_name: str,
    connector_config: dict[str, Any],
) -> dict[str, Any]:
    """
    Update a knowledge connector.
    """

    workspace = _validate_workspace(
        project_name,
        workspace_name,
    )

    if not workspace.get("access"):
        return workspace

    existing = _api_get(
    "/connector/knowledge/connector_by_id",
    {
        "connector_id": connector_id,
    },
    )

    existing_connector = existing.get("connectors", {})

    for field in [
        "id",
        "connector_id",
        "created_by",
        "created_on",
    ]:
        existing_connector.pop(field, None)

    merged_config = {
        **existing_connector,
        **connector_config,
    }

    validate_payload = {
        "connector_name": connector_name,
        "connection_name": connection_name,
        **merged_config,
    }

    validation = _api_post(
        "/connector/knowledge/validate",
        validate_payload,
    )

    if not validation.get("success"):
        return validation

    update_payload = {
        "connector_type": "knowledge",
        "connector_name": connector_name,
        "connection_name": connection_name,
        "automation_type": "Manual",
        "ingestion_automation": "False",
        "updated_by": "Admin",
        **merged_config,
    }

    result = _api_post(
        f"/connector/knowledge/update/{connector_id}",
        update_payload,
    )

    return result
@secure_tool()
def delete_knowledge_connector(
    project_name: str,
    workspace_name: str,
    connector_id: int,
) -> dict[str, Any]:

    workspace = _validate_workspace(
        project_name,
        workspace_name,
    )

    if not workspace.get("access"):
        return workspace

    return _api_delete(
        "/connector/knowledge/delete",
        {
            "connector_id": connector_id,
        },
    )


@secure_tool()
def get_workspace_job_schedulers(
    project_name: str,
    workspace_name: str,
) -> dict[str, Any]:

    workspace = _validate_workspace(
        project_name,
        workspace_name,
    )

    if not workspace.get("access"):
        return workspace

    response = _api_get(
        "/connector/utility/get_schedulers",
        {
            "workspace_id": workspace["workspace_id"]
        },
    )

    return {
        "access": True,
        "project_name": project_name,
        "workspace_name": workspace_name,
        "schedulers": response.get("connectors", []),
    }


