    persona    = brand.get('hcp_persona', MEDICAL_TEAM_PERSONA) if is_hcp else brand.get('patient_persona', PATIENT_SUPPORT_PERSONA)
    team_label = 'Medical Team'       if is_hcp else 'Patient Support Team'

