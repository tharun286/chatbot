def _project_model_ids(project_name: str) -> set[int]:
    """IDs of the models that belong to a project, from the project-filtered list endpoint.

    The single-model endpoint returns project.projectName as an empty string, so it cannot
    be used to verify membership. Membership must come from the project-filtered list.
    """
    data = _api_get(
        "/crud/aibuddy/api/get/confignameandids",
        {"projectName": project_name},
        timeout=60,
    )
    if not isinstance(data, list):
        return set()
    ids: set[int] = set()
    for model in data:
        if isinstance(model, dict) and model.get("id") is not None:
            try:
                ids.add(int(model["id"]))
            except (TypeError, ValueError):
                continue
    return ids


def _is_secret_field(field_name: str) -> bool:
    return "apikey" in field_name.lower().replace("_", "").replace("-", "")


def _fetch_model_detail(project_name: str, model_id: int) -> dict[str, Any] | None:
    """Full model record, or None if the model is not in the project or is deleted."""
    if model_id not in _project_model_ids(project_name):
        return None
    data = _api_get(f"/crud/aibuddy/api/get/config/{model_id}", timeout=60)
    if not isinstance(data, dict) or data.get("deleted"):
        return None
    return data


def _secret_field_name(data: dict[str, Any]) -> str | None:
    for detail in data.get("apiDetails") or []:
        if isinstance(detail, dict) and _is_secret_field(str(detail.get("fieldName") or "")):
            return str(detail["fieldName"])
    return None


def _model_view(data: dict[str, Any]) -> dict[str, Any]:
    settings: dict[str, Any] = {}
    api_key_configured = False
    for detail in data.get("apiDetails") or []:
        if not isinstance(detail, dict):
            continue
        field = str(detail.get("fieldName") or "")
        if _is_secret_field(field):
            api_key_configured = bool(detail.get("value"))
            continue
        settings[field] = detail.get("value")

    return {
        "id": data.get("id"),
        "api_name": data.get("apiName"),
        "description": data.get("description"),
        "type": data.get("type"),
        "config_enabled": data.get("configEnabled"),
        "default": data.get("default"),
        "api_key_configured": api_key_configured,
        "settings": settings,
    }


@secure_tool()
