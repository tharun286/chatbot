    """Get one AI model configuration in an accessible project, for editing.

    API key values are never returned. The response only says whether a key is set.
    """
    data = _fetch_model_detail(project_name, model_id)
    if data is None:
        return _error(project_name, f"Model {model_id} was not found in project '{project_name}'.")
    return {"access": True, "project_name": project_name, "model": _model_view(data)}


# Tool argument -> settings field name in the API.
_EDITABLE_SETTINGS: dict[str, str] = {
    "model_name": "model",
    "is_batch": "isBatch",
    "input_token_cost": "inputTokenCost",
    "output_token_cost": "outputTokenCost",
    "max_token_size": "maxTokenSize",
    "tokens_per_minute": "tokensPerMinute",
}


def _format_number(value: float | int) -> str:
    if isinstance(value, float):
        return f"{value:.10f}".rstrip("0").rstrip(".")
    return str(value)


@secure_tool()
def update_project_model(
    project_name: str,
    model_id: int,
    api_name: str | None = None,
    description: str | None = None,
    config_enabled: bool | None = None,
    model_name: str | None = None,
    is_batch: bool | None = None,
    input_token_cost: float | None = None,
    output_token_cost: float | None = None,
    max_token_size: int | None = None,
    tokens_per_minute: int | None = None,
    api_key: str | None = None,
) -> dict[str, Any]:
    """Update an AI model in an accessible project.

    Only the fields you pass are changed; everything else keeps its current value.
    The API type cannot be changed. Pass api_key only to replace the key. The
    stored key is never returned.
    """
    current = _fetch_model_detail(project_name, model_id)
    if current is None:
        return _error(project_name, f"Model {model_id} was not found in project '{project_name}'.")

    if api_name is not None and not api_name.strip():
        return _error(project_name, "api_name cannot be blank.")
    if api_key is not None and not api_key.strip():
        return _error(project_name, "api_key cannot be blank. Omit it to keep the current key.")
    if input_token_cost is not None and input_token_cost < 0:
        return _error(project_name, "input_token_cost cannot be negative.")
    if output_token_cost is not None and output_token_cost < 0:
        return _error(project_name, "output_token_cost cannot be negative.")
    if max_token_size is not None and max_token_size <= 0:
        return _error(project_name, "max_token_size must be greater than 0.")
    if tokens_per_minute is not None and tokens_per_minute <= 0:
        return _error(project_name, "tokens_per_minute must be greater than 0.")

    secret_field = _secret_field_name(current)
    if api_key is not None and secret_field is None:
        return _error(project_name, "This model has no API key field to update.")

    view = _model_view(current)
    settings: dict[str, str] = {k: "" if v is None else str(v) for k, v in view["settings"].items()}

    requested = {
        "model_name": model_name,
        "is_batch": is_batch,
        "input_token_cost": input_token_cost,
        "output_token_cost": output_token_cost,
        "max_token_size": max_token_size,
        "tokens_per_minute": tokens_per_minute,
    }
    for arg_name, api_field in _EDITABLE_SETTINGS.items():
        value = requested[arg_name]
        if value is None:
            continue
        if api_field == "isBatch":
            settings[api_field] = "true" if value else "false"
        elif isinstance(value, str):
            settings[api_field] = value.strip()
        else:
            settings[api_field] = _format_number(value)

    details = [{"fieldName": field, "value": value} for field, value in settings.items()]
    if api_key is not None and secret_field is not None:
        details.append({"fieldName": secret_field, "value": api_key.strip()})

    payload = {
        "id": model_id,
        "apiName": api_name.strip() if api_name is not None else current.get("apiName"),
        "description": description if description is not None else current.get("description"),
        "type": current.get("type"),
        "isConfigEnabled": config_enabled if config_enabled is not None else bool(current.get("configEnabled")),
        "project": {"projectName": project_name},
        "apiDetails": details,
    }
    _api_request("PUT", f"/crud/aibuddy/api/update/config/{model_id}", json_body=payload, timeout=60)

    changed = {
        "api_name": api_name,
        "description": description,
        "config_enabled": config_enabled,
        "model_name": model_name,
        "is_batch": is_batch,
        "input_token_cost": input_token_cost,
        "output_token_cost": output_token_cost,
        "max_token_size": max_token_size,
        "tokens_per_minute": tokens_per_minute,
        "api_key": api_key,
    }
    updated_fields = [name for name, value in changed.items() if value is not None]

    saved = _fetch_model_detail(project_name, model_id)
    return {
        "access": True,
        "project_name": project_name,
        "updated_fields": updated_fields,
        "model": _model_view(saved) if saved else None,
    }


