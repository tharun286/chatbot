@secure_tool()
def manage_workspace(
    project_name: str,
    action: str,
    workspace_name: str | None = None,
    new_workspace_name: str | None = None,
    short_description: str | None = None,
) -> dict[str, Any]:
    """Create, update, or delete a workspace in an accessible project.

    action:
        create - Create a new public workspace.
        update - Update an existing workspace.
        delete - Delete an existing workspace.

    For create:
        Pass new_workspace_name and short_description.

    For update:
        Pass workspace_name.
        Pass new_workspace_name only when renaming the workspace.
        Pass short_description only when changing the description.

    For delete:
        Pass workspace_name.

    Project and workspace IDs are resolved automatically.
    """

    normalized_action = action.strip().lower()

    if normalized_action not in {"create", "update", "delete"}:
        return _error(
            project_name,
            "action must be 'create', 'update', or 'delete'.",
        )

    # ------------------------------------------------------------------
    # CREATE
    # ------------------------------------------------------------------
    if normalized_action == "create":

        if not new_workspace_name or not new_workspace_name.strip():
            return _error(
                project_name,
                "new_workspace_name is required for create.",
            )

        if not short_description or not short_description.strip():
            return _error(
                project_name,
                "short_description is required for create.",
            )

        new_workspace_name = new_workspace_name.strip()
        short_description = short_description.strip()

        if len(short_description) > 200:
            return _error(
                project_name,
                "short_description cannot exceed 200 characters.",
            )

        try:
            project = _get_project_record(project_name)
        except ValueError as exc:
            return _error(project_name, str(exc))

        project_id = project.get("id")

        if project_id is None:
            return _error(
                project_name,
                f"Project ID was not found for '{project_name}'.",
            )

        if not project.get("workspaceAccess"):
            return _error(
                project_name,
                f"Workspace creation is not enabled for project '{project_name}'.",
            )

        try:
            user_id = _extract_user_id(_get_user_record())
        except ValueError as exc:
            return _error(project_name, str(exc))

        payload = {
            "name": new_workspace_name,
            "description": short_description,
            "workspaceType": "Public",
            "createdBy": user_id,
            "projectId": int(project_id),
            "detailedIndex": True,
            "doclingSupport": False,
            "markdownIndex": True,
            "summaryIndex": True,
            "supportsImageProcessingInDocuments": False,
            "workspaceStatus": True,
        }

        try:
            response = _api_request(
                "POST",
                "/crud/create_workspace",
                json_body=payload,
                timeout=60,
            )

            data = response.json()

        except requests.HTTPError as exc:
            status_code = (
                exc.response.status_code
                if exc.response is not None
                else None
            )

            return _error(
                project_name,
                f"Workspace creation failed with HTTP {status_code}.",
            )

        except ValueError:
            return _error(
                project_name,
                "Workspace creation API returned an invalid response.",
            )

        return {
            "access": True,
            "action": "create",
            "project_name": project_name,
            "workspace_name": new_workspace_name,
            "workspace_uuid": (
                data.get("uuid")
                if isinstance(data, dict)
                else None
            ),
            "message": (
                data.get("message")
                if isinstance(data, dict)
                else "Workspace created successfully."
            ),
        }

    # ------------------------------------------------------------------
    # UPDATE / DELETE
    # Both require an existing workspace.
    # ------------------------------------------------------------------

    if not workspace_name or not workspace_name.strip():
        return _error(
            project_name,
            "workspace_name is required for update and delete.",
        )

    workspace_name = workspace_name.strip()

    workspace = _validate_workspace(
        project_name,
        workspace_name,
    )

    if not workspace.get("access"):
        return workspace

    workspace_uuid = workspace.get("workspace_uuid")

    if not workspace_uuid:
        return _error(
            project_name,
            f"Workspace UUID was not found for '{workspace_name}'.",
        )

    # ------------------------------------------------------------------
    # UPDATE
    # ------------------------------------------------------------------
    if normalized_action == "update":

        # Get complete existing workspace information so fields that were
        # not requested keep their current values.
        existing = None

        for ws in _fetch_project_workspaces(project_name):
            if str(ws.get("workspace_uuid")) == str(workspace_uuid):
                existing = ws
                break

        if existing is None:
            return _error(
                project_name,
                f"Workspace '{workspace_name}' could not be loaded.",
            )

        updated_name = (
            new_workspace_name.strip()
            if new_workspace_name is not None
            and new_workspace_name.strip()
            else workspace_name
        )

        if short_description is not None:
            short_description = short_description.strip()

            if not short_description:
                return _error(
                    project_name,
                    "short_description cannot be blank.",
                )

            if len(short_description) > 200:
                return _error(
                    project_name,
                    "short_description cannot exceed 200 characters.",
                )

        try:
            user_id = _extract_user_id(_get_user_record())
        except ValueError as exc:
            return _error(project_name, str(exc))

        payload = {
            "name": updated_name,
            "description": (
                short_description
                if short_description is not None
                else existing.get("workspace_description")
            ),
            "workspace_type": (
                existing.get("workspace_type") or "Public"
            ),
            "workspace_status": (
                existing.get("workspace_status")
                if existing.get("workspace_status") is not None
                else True
            ),
            "updated_by": user_id,
        }

        try:
            response = _api_request(
                "PUT",
                f"/crud/workspace_details/{workspace_uuid}",
                json_body=payload,
                timeout=60,
            )

            data = response.json()

        except requests.HTTPError as exc:
            status_code = (
                exc.response.status_code
                if exc.response is not None
                else None
            )

            return _error(
                project_name,
                f"Workspace update failed with HTTP {status_code}.",
            )

        except ValueError:
            return _error(
                project_name,
                "Workspace update API returned an invalid response.",
            )

        return {
            "access": True,
            "action": "update",
            "project_name": project_name,
            "workspace_name": updated_name,
            "workspace_uuid": workspace_uuid,
            "message": (
                data.get("message")
                if isinstance(data, dict)
                else "Workspace updated successfully."
            ),
        }

    # ------------------------------------------------------------------
    # DELETE
    # ------------------------------------------------------------------

    try:
        response = _api_request(
            "DELETE",
            "/crud/delete_workspace",
            params={
                "workspace_uuid": workspace_uuid,
            },
            timeout=60,
        )

        data = response.json()

    except requests.HTTPError as exc:
        status_code = (
            exc.response.status_code
            if exc.response is not None
            else None
        )

        return _error(
            project_name,
            f"Workspace deletion failed with HTTP {status_code}.",
        )

    except ValueError:
        return _error(
            project_name,
            "Workspace delete API returned an invalid response.",
        )

    return {
        "access": True,
        "action": "delete",
        "project_name": project_name,
        "workspace_name": workspace_name,
        "workspace_uuid": workspace_uuid,
        "message": (
            data.get("message")
            if isinstance(data, dict)
            else "Workspace deleted successfully."
        ),
    }

